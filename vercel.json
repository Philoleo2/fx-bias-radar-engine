{
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(index.html|app.js|styles.css|pre_rottura.html|pre_rottura.js)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "functions": {
    "api/scan.py": { "maxDuration": 60 },
    "api/health.py": { "maxDuration": 10 },
    "api/pre_rottura.py": { "maxDuration": 10, "includeFiles": "reports/prerottura/**" }
  }
}
