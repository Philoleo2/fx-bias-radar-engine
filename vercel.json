{
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(index.html|app.js|styles.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/scan.py": {
      "maxDuration": 60
    },
    "api/health.py": {
      "maxDuration": 10
    }
  }
}
