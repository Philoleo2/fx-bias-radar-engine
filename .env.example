# Copy this file to .env locally and fill the values.
# Never commit .env and never paste the token in chat.

OANDA_ENV=practice
OANDA_BASE_URL=https://api-fxpractice.oanda.com
OANDA_ACCOUNT_ID=your-practice-account-id
OANDA_ACCESS_TOKEN=your-personal-access-token
DASHBOARD_TOKEN=choose-a-private-dashboard-token
CACHE_SECONDS=0
